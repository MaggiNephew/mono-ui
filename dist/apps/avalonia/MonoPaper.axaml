<!-- Mono paper for Avalonia (Fluent theme). generated by mono-ui from tokens/mono.json - edit the tokens, not this file
     App.axaml:  <Application.Styles><FluentTheme /><StyleInclude Source="avares://YourApp/MonoPaper.axaml" /></Application.Styles>
     and set RequestedThemeVariant="Light". -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
    <SolidColorBrush x:Key="MonoBgBrush" Color="#f2f2f2" />
    <SolidColorBrush x:Key="MonoBgAltBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="MonoSurfaceBrush" Color="#e9e9e9" />
    <SolidColorBrush x:Key="MonoSurfaceAltBrush" Color="#e4e4e4" />
    <SolidColorBrush x:Key="MonoFgStrongBrush" Color="#000000" />
    <SolidColorBrush x:Key="MonoFgBrush" Color="#111111" />
    <SolidColorBrush x:Key="MonoFgDimBrush" Color="#333333" />
    <SolidColorBrush x:Key="MonoFgMutedBrush" Color="#5c5c5c" />
    <SolidColorBrush x:Key="MonoFgFaintBrush" Color="#858585" />
    <SolidColorBrush x:Key="MonoLineSoftBrush" Color="#dcdcdc" />
    <SolidColorBrush x:Key="MonoLineBrush" Color="#bcbcbc" />
    <SolidColorBrush x:Key="MonoLineStrongBrush" Color="#868686" />
    <SolidColorBrush x:Key="MonoFocusBrush" Color="#111111" />
    <SolidColorBrush x:Key="MonoTintBrush" Color="#e7e7e7" />
    <SolidColorBrush x:Key="MonoAccentBrush" Color="#111111" />
    <SolidColorBrush x:Key="MonoAccentHoverBrush" Color="#3a3a3a" />
    <SolidColorBrush x:Key="MonoOnAccentBrush" Color="#f2f2f2" />
    <SolidColorBrush x:Key="MonoSelectionBrush" Color="#d2d2d2" />
    <SolidColorBrush x:Key="MonoOnSelectionBrush" Color="#000000" />
    <SolidColorBrush x:Key="MonoDisabledBrush" Color="#a3a3a3" />
    <SolidColorBrush x:Key="MonoShadowBrush" Color="#f2f2f2" />
      <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
      <FontFamily x:Key="ContentControlThemeFontFamily">Space Grotesk</FontFamily>
      <Color x:Key="SystemAccentColor">#111111</Color>
      <Color x:Key="SystemAccentColorLight1">#3a3a3a</Color>
      <Color x:Key="SystemAccentColorDark1">#5c5c5c</Color>
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#f2f2f2" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#111111" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#5c5c5c" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#ffffff" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#ffffff" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#ffffff" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#bcbcbc" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#868686" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#111111" />
      <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#e9e9e9" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#e4e4e4" />
      <SolidColorBrush x:Key="ButtonForeground" Color="#111111" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#111111" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#111111" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window"><Setter Property="Background" Value="{StaticResource MonoBgBrush}" /></Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="48" /><Setter Property="Foreground" Value="{StaticResource MonoFgBrush}" /><Setter Property="FontFamily" Value="Fraunces" /><Setter Property="FontWeight" Value="300" /></Style>
  <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="20" /><Setter Property="Foreground" Value="{StaticResource MonoFgBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /><Setter Property="FontWeight" Value="Bold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /></Style>
  <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource MonoFgFaintBrush}" /></Style>
  <Style Selector="Button"><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="18,11" /></Style>
  <Style Selector="Button.fill"><Setter Property="Background" Value="{StaticResource MonoAccentBrush}" /><Setter Property="Foreground" Value="{StaticResource MonoOnAccentBrush}" /><Setter Property="BorderBrush" Value="{StaticResource MonoAccentBrush}" /></Style>
  <Style Selector="Button.fill:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource MonoAccentHoverBrush}" /><Setter Property="Foreground" Value="{StaticResource MonoOnAccentBrush}" /></Style>
  <Style Selector="Button.line"><Setter Property="BorderBrush" Value="{StaticResource MonoLineStrongBrush}" /></Style>
  <Style Selector="Button.ghost"><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="{StaticResource MonoSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource MonoLineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Padding" Value="16,14" /></Style>
</Styles>
