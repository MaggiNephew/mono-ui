<!-- Mono round for Avalonia (Fluent theme). generated by mono-ui from tokens/mono.json - edit the tokens, not this file
     App.axaml:  <Application.Styles><FluentTheme /><StyleInclude Source="avares://YourApp/MonoRound.axaml" /></Application.Styles>
     and set RequestedThemeVariant="Dark". -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
    <SolidColorBrush x:Key="MonoBgBrush" Color="#131313" />
    <SolidColorBrush x:Key="MonoBgAltBrush" Color="#0a0a0a" />
    <SolidColorBrush x:Key="MonoSurfaceBrush" Color="#1f1f1f" />
    <SolidColorBrush x:Key="MonoSurfaceAltBrush" Color="#2a2a2a" />
    <SolidColorBrush x:Key="MonoFgStrongBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="MonoFgBrush" Color="#e2e2e2" />
    <SolidColorBrush x:Key="MonoFgDimBrush" Color="#c6c6c6" />
    <SolidColorBrush x:Key="MonoFgMutedBrush" Color="#999999" />
    <SolidColorBrush x:Key="MonoFgFaintBrush" Color="#777777" />
    <SolidColorBrush x:Key="MonoLineSoftBrush" Color="#2a2a2a" />
    <SolidColorBrush x:Key="MonoLineBrush" Color="#333333" />
    <SolidColorBrush x:Key="MonoLineStrongBrush" Color="#919191" />
    <SolidColorBrush x:Key="MonoFocusBrush" Color="#999999" />
    <SolidColorBrush x:Key="MonoTintBrush" Color="#212121" />
    <SolidColorBrush x:Key="MonoAccentBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="MonoAccentHoverBrush" Color="#c6c6c6" />
    <SolidColorBrush x:Key="MonoOnAccentBrush" Color="#1b1b1b" />
    <SolidColorBrush x:Key="MonoSelectionBrush" Color="#3a3a3a" />
    <SolidColorBrush x:Key="MonoOnSelectionBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="MonoDisabledBrush" Color="#777777" />
    <SolidColorBrush x:Key="MonoShadowBrush" Color="#0b0b0b" />
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
      <FontFamily x:Key="ContentControlThemeFontFamily">3270 Nerd Font</FontFamily>
      <Color x:Key="SystemAccentColor">#ffffff</Color>
      <Color x:Key="SystemAccentColorLight1">#c6c6c6</Color>
      <Color x:Key="SystemAccentColorDark1">#999999</Color>
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#131313" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#e2e2e2" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#999999" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#0a0a0a" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0a0a0a" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0a0a0a" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#333333" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#919191" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#999999" />
      <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1f1f1f" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2a2a2a" />
      <SolidColorBrush x:Key="ButtonForeground" Color="#e2e2e2" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#e2e2e2" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#e2e2e2" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window"><Setter Property="Background" Value="{StaticResource MonoBgBrush}" /></Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="30" /><Setter Property="Foreground" Value="{StaticResource MonoFgBrush}" /><Setter Property="FontFamily" Value="3270 Nerd Font" /><Setter Property="FontWeight" Value="400" /></Style>
  <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="18" /><Setter Property="Foreground" Value="{StaticResource MonoFgBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /><Setter Property="FontWeight" Value="Bold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /></Style>
  <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource MonoFgFaintBrush}" /></Style>
  <Style Selector="Button"><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,6" /></Style>
  <Style Selector="Button.fill"><Setter Property="Background" Value="{StaticResource MonoAccentBrush}" /><Setter Property="Foreground" Value="{StaticResource MonoOnAccentBrush}" /><Setter Property="BorderBrush" Value="{StaticResource MonoAccentBrush}" /></Style>
  <Style Selector="Button.fill:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource MonoAccentHoverBrush}" /><Setter Property="Foreground" Value="{StaticResource MonoOnAccentBrush}" /></Style>
  <Style Selector="Button.line"><Setter Property="BorderBrush" Value="{StaticResource MonoLineStrongBrush}" /></Style>
  <Style Selector="Button.ghost"><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="{StaticResource MonoSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource MonoLineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16,14" /></Style>
</Styles>
