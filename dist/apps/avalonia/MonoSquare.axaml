<!-- Mono square for Avalonia (Fluent theme). generated by mono-ui from tokens/mono.json - edit the tokens, not this file
     App.axaml:  <Application.Styles><FluentTheme /><StyleInclude Source="avares://YourApp/MonoSquare.axaml" /></Application.Styles>
     and set RequestedThemeVariant="Dark". -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
    <SolidColorBrush x:Key="MonoBgBrush" Color="#0a0a0a" />
    <SolidColorBrush x:Key="MonoBgAltBrush" Color="#000000" />
    <SolidColorBrush x:Key="MonoSurfaceBrush" Color="#101010" />
    <SolidColorBrush x:Key="MonoSurfaceAltBrush" Color="#151515" />
    <SolidColorBrush x:Key="MonoFgStrongBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="MonoFgBrush" Color="#e2e2e2" />
    <SolidColorBrush x:Key="MonoFgDimBrush" Color="#b4b4b4" />
    <SolidColorBrush x:Key="MonoFgMutedBrush" Color="#919191" />
    <SolidColorBrush x:Key="MonoFgFaintBrush" Color="#787878" />
    <SolidColorBrush x:Key="MonoLineSoftBrush" Color="#202020" />
    <SolidColorBrush x:Key="MonoLineBrush" Color="#3a3a3a" />
    <SolidColorBrush x:Key="MonoLineStrongBrush" Color="#656565" />
    <SolidColorBrush x:Key="MonoFocusBrush" Color="#e2e2e2" />
    <SolidColorBrush x:Key="MonoTintBrush" Color="#151515" />
    <SolidColorBrush x:Key="MonoAccentBrush" Color="#e2e2e2" />
    <SolidColorBrush x:Key="MonoAccentHoverBrush" Color="#b4b4b4" />
    <SolidColorBrush x:Key="MonoOnAccentBrush" Color="#0a0a0a" />
    <SolidColorBrush x:Key="MonoSelectionBrush" Color="#313131" />
    <SolidColorBrush x:Key="MonoOnSelectionBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="MonoDisabledBrush" Color="#555555" />
    <SolidColorBrush x:Key="MonoShadowBrush" Color="#0a0a0a" />
      <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
      <FontFamily x:Key="ContentControlThemeFontFamily">Space Grotesk</FontFamily>
      <Color x:Key="SystemAccentColor">#e2e2e2</Color>
      <Color x:Key="SystemAccentColorLight1">#b4b4b4</Color>
      <Color x:Key="SystemAccentColorDark1">#919191</Color>
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#0a0a0a" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#e2e2e2" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#919191" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#000000" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#000000" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3a3a3a" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#656565" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#e2e2e2" />
      <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#101010" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#151515" />
      <SolidColorBrush x:Key="ButtonForeground" Color="#e2e2e2" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#e2e2e2" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#e2e2e2" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window"><Setter Property="Background" Value="{StaticResource MonoBgBrush}" /></Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="48" /><Setter Property="Foreground" Value="{StaticResource MonoFgBrush}" /><Setter Property="FontFamily" Value="Fraunces" /><Setter Property="FontWeight" Value="300" /></Style>
  <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="20" /><Setter Property="Foreground" Value="{StaticResource MonoFgBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /><Setter Property="FontWeight" Value="Bold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /></Style>
  <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource MonoFgFaintBrush}" /></Style>
  <Style Selector="Button"><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="18,11" /></Style>
  <Style Selector="Button.fill"><Setter Property="Background" Value="{StaticResource MonoAccentBrush}" /><Setter Property="Foreground" Value="{StaticResource MonoOnAccentBrush}" /><Setter Property="BorderBrush" Value="{StaticResource MonoAccentBrush}" /></Style>
  <Style Selector="Button.fill:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource MonoAccentHoverBrush}" /><Setter Property="Foreground" Value="{StaticResource MonoOnAccentBrush}" /></Style>
  <Style Selector="Button.line"><Setter Property="BorderBrush" Value="{StaticResource MonoLineStrongBrush}" /></Style>
  <Style Selector="Button.ghost"><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource MonoFgMutedBrush}" /></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="{StaticResource MonoSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource MonoLineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Padding" Value="16,14" /></Style>
</Styles>
