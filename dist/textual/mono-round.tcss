/* mono-ui for Textual -- generated by mono-ui from tokens/mono.json -- edit the tokens, not this file
   Classes: .h1 .label .muted .faint .card .stats .cell, Button.-fill/.-line/.-ghost */

Screen { background: $background; color: $foreground; }

/* ---------- type ---------- */
.h1 { color: $mono-fg; text-style: bold; }
.label { color: $mono-fg-muted; text-style: none; }
.muted { color: $mono-fg-muted; }
.faint { color: $mono-fg-faint; }

/* ---------- containers ---------- */
.card { background: $mono-surface; border: round $mono-line; padding: 0 1; height: auto; }
.stats { border: round $mono-line; height: auto; }
.cell { border-right: vkey $mono-line; padding: 0 1; width: 1fr; height: auto; }
.cell:last-child { border-right: none; }
.cell .value { color: $mono-fg; text-style: bold; }

/* ---------- buttons ---------- */
Button {
  background: $background; color: $mono-fg; border: round $mono-fg; height: 3; min-width: 10;
  text-style: none; tint: transparent;
}
Button:hover { background: $mono-surface; border: round $mono-fg-strong; }
Button:focus { text-style: none; background-tint: transparent; }
Button.-fill { background: $mono-accent; color: $mono-on-accent; border: round $mono-accent; }
Button.-fill:hover { background: $mono-accent-hover; border: round $mono-accent-hover; }
Button.-line { border: round $mono-line-strong; }
Button.-ghost { border: round $background; color: $mono-fg-muted; }
Button.-ghost:hover { color: $mono-fg; border: round $mono-surface; }
Button:disabled { color: $mono-disabled; border: round $mono-line; background: $background; }

/* ---------- inputs ---------- */
Input, Select > SelectCurrent, TextArea { background: $mono-bg-alt; color: $mono-fg; border: round $mono-line; }
Input:focus, Select:focus > SelectCurrent, TextArea:focus { border: round $mono-focus; }
Input > .input--placeholder { color: $mono-fg-faint; }
Checkbox, RadioButton { background: transparent; border: none; color: $mono-fg; }
Switch { background: transparent; border: round $mono-line; }
Switch:focus { border: round $mono-focus; }
ProgressBar Bar > .bar--bar { color: $mono-fg; background: $mono-line-soft; }
ProgressBar Bar > .bar--complete { color: $mono-fg-strong; }

/* ---------- tabs, tables, lists ---------- */
Tabs { background: $background; }
Tab { color: $mono-fg-muted; text-style: none; }
Tab.-active { color: $mono-fg; }
Underline > .underline--bar { color: $mono-fg; background: $mono-line; }
DataTable { background: $mono-bg-alt; border: round $mono-line; }
DataTable > .datatable--header { background: $mono-bg-alt; color: $mono-fg-muted; text-style: none; }
DataTable > .datatable--cursor { background: $mono-selection; color: $mono-on-selection; }
ListView, OptionList { background: $mono-bg-alt; border: round $mono-line; }
ListView > ListItem.-highlight, OptionList > .option-list--option-highlighted { background: $mono-selection; color: $mono-on-selection; }
Header { background: $mono-bg-alt; color: $mono-fg; }
Footer { background: $mono-bg-alt; }
Footer .footer-key--key { background: $mono-surface-alt; color: $mono-fg; }
Footer .footer-key--description { color: $mono-fg-muted; }
Log, RichLog { background: $mono-bg-alt; border: round $mono-line-soft; color: $mono-fg-dim; }
