/* generated by mono-ui from tokens/mono.json -- edit the tokens, not this file */
/* mono-ui Qt stylesheet (paper). Use with the Fusion style; the helper sets that up.
   Widget roles via dynamic properties:
     QLabel[role="h1"|"h2"|"h3"|"label"|"muted"|"faint"|"mono"]
     QPushButton[kind="fill"|"line"|"ghost"]   (default = outline)
     QFrame[role="card"|"panel"|"rule"|"stats"|"cell"]  */

* { outline: none; }

QWidget {
  background: #f2f2f2; color: #333333;
  font-family: "Space Grotesk"; font-size: 14px;
  selection-background-color: #d2d2d2; selection-color: #000000;
}
QMainWindow, QDialog { background: #f2f2f2; }
QWidget:disabled { color: #a3a3a3; }

/* ---------- type ---------- */
QLabel { background: transparent; color: #333333; }
QLabel[role="h1"] { font-family: "Fraunces"; font-size: 48px; font-weight: 300; color: #111111; }
QLabel[role="h2"] { font-family: "Fraunces"; font-size: 34px; font-weight: 300; color: #111111; }
QLabel[role="h3"] { font-family: "Space Grotesk"; font-size: 20px; font-weight: 500; color: #111111; }
QLabel[role="label"] { font-family: "Space Grotesk"; font-size: 11px; font-weight: 500; color: #5c5c5c; }
QLabel[role="muted"] { color: #5c5c5c; }
QLabel[role="faint"] { color: #858585; }
QLabel[role="mono"] { font-family: "Space Mono"; font-size: 12px; color: #333333; }
QLabel[role="stat"] { font-family: "Fraunces"; font-size: 34px; font-weight: 300; color: #111111; }

/* ---------- frames ---------- */
QFrame[role="card"] { background: #e9e9e9; border: 1px solid #bcbcbc; border-radius: 0px; }
QFrame[role="card"] QLabel { background: transparent; }
QFrame[role="panel"] { background: transparent; border: 1px solid #bcbcbc; border-radius: 0px; }
QFrame[role="rule"] { background: #bcbcbc; border: none; max-height: 1px; min-height: 1px; }
QFrame[role="stats"] { background: transparent; border: 1px solid #bcbcbc; border-radius: 0px; }
QFrame[role="cell"] { background: transparent; border: none; border-right: 1px solid #bcbcbc; }

/* ---------- buttons ---------- */
QPushButton, QToolButton {
  background: transparent; color: #111111; border: 1px solid #111111; border-radius: 0px;
  min-height: 38px; padding: 0 18px;
  font-family: "Space Grotesk"; font-size: 11px; font-weight: 500;
}
QPushButton:hover, QToolButton:hover { background: #e7e7e7; }
QPushButton:pressed, QToolButton:pressed { background: #e4e4e4; }
QPushButton:focus, QToolButton:focus { border: 1px solid #111111; }
QPushButton[kind="fill"], QPushButton:default { background: #111111; color: #f2f2f2; border-color: #111111; }
QPushButton[kind="fill"]:hover, QPushButton:default:hover { background: #3a3a3a; border-color: #3a3a3a; }
QPushButton[kind="line"] { border-color: #868686; }
QPushButton[kind="line"]:hover { border-color: #111111; }
QPushButton[kind="ghost"] { border-color: transparent; color: #5c5c5c; }
QPushButton[kind="ghost"]:hover { color: #111111; background: #e7e7e7; }
QPushButton:disabled, QToolButton:disabled { color: #a3a3a3; border-color: #bcbcbc; background: transparent; }
QPushButton:checked, QToolButton:checked { background: #111111; color: #f2f2f2; border-color: #111111; }
QToolButton { padding: 0 8px; }
QToolButton[popupMode="1"] { padding-right: 20px; }
QToolButton::menu-button { border: none; width: 16px; }

/* ---------- text inputs ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit, QComboBox {
  background: #ffffff; color: #111111; border: 1px solid #bcbcbc; border-radius: 0px;
  min-height: 38px; padding: 0 10px;
}
QTextEdit, QPlainTextEdit {
  background: #ffffff; color: #111111; border: 1px solid #bcbcbc; border-radius: 0px; padding: 6px 8px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover, QTextEdit:hover, QPlainTextEdit:hover { border-color: #868686; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus { border: 1px solid #111111; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QTextEdit:disabled { color: #a3a3a3; border-color: #dcdcdc; }
QLineEdit[echoMode="2"] { lineedit-password-character: 9679; }

QComboBox { padding-right: 28px; }
QComboBox::drop-down { border: none; width: 26px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url(mono:chevron-down.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView {
  background: #e9e9e9; color: #111111; border: 1px solid #868686; border-radius: 0px;
  padding: 4px; selection-background-color: #d2d2d2; selection-color: #000000; outline: none;
}
QAbstractSpinBox { padding-left: 10px; }
QSpinBox::up-button, QDoubleSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateEdit::up-button, QDateEdit::down-button, QTimeEdit::up-button, QTimeEdit::down-button,
QDateTimeEdit::up-button, QDateTimeEdit::down-button { border: none; width: 18px; background: transparent; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QDateEdit::up-arrow, QTimeEdit::up-arrow, QDateTimeEdit::up-arrow { image: url(mono:chevron-up.svg); width: 8px; height: 8px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QDateEdit::down-arrow, QTimeEdit::down-arrow, QDateTimeEdit::down-arrow { image: url(mono:chevron-down.svg); width: 8px; height: 8px; }

/* ---------- check / radio ---------- */
QCheckBox, QRadioButton { background: transparent; color: #111111; spacing: 10px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #868686; background: #ffffff; }
QCheckBox::indicator { border-radius: 0px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #111111; }
QCheckBox::indicator:checked { background: #111111; border-color: #111111; image: url(mono:check.svg); }
QCheckBox::indicator:indeterminate { background: #111111; border-color: #111111; image: url(mono:dash.svg); }
QRadioButton::indicator:checked { border-color: #111111; image: url(mono:radio.svg); }
QCheckBox:disabled, QRadioButton:disabled { color: #a3a3a3; }

/* ---------- sliders & progress ---------- */
QSlider { background: transparent; }
QSlider::groove:horizontal { height: 2px; background: #868686; border-radius: 1px; }
QSlider::sub-page:horizontal { background: #111111; border-radius: 1px; }
QSlider::handle:horizontal { width: 14px; height: 14px; margin: -6px 0; background: #000000; border-radius: 0px; }
QSlider::groove:vertical { width: 2px; background: #868686; }
QSlider::add-page:vertical { background: #111111; }
QSlider::handle:vertical { width: 14px; height: 14px; margin: 0 -6px; background: #000000; border-radius: 0px; }
QProgressBar { background: #dcdcdc; border: none; border-radius: 0px; max-height: 4px; min-height: 4px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #111111; border-radius: 0px; }

/* ---------- tabs ---------- */
QTabWidget::pane { border: 1px solid #bcbcbc; border-radius: 0px; top: -1px; background: #f2f2f2; }
QTabBar { background: transparent; qproperty-drawBase: 0; }
QTabBar::tab {
  background: transparent; color: #5c5c5c; border: 1px solid transparent; border-bottom: none;
  padding: 7px 14px; margin-right: 2px; font-family: "Space Grotesk"; font-size: 11px; font-weight: 500;
  border-top-left-radius: 0px; border-top-right-radius: 0px;
}
QTabBar::tab:hover { color: #111111; }
QTabBar::tab:selected { color: #111111; background: #f2f2f2; border-color: #bcbcbc; }

/* ---------- item views ---------- */
QListView, QTreeView, QTableView, QListWidget, QTreeWidget, QTableWidget {
  background: #ffffff; alternate-background-color: #e9e9e9; color: #111111;
  border: 1px solid #bcbcbc; border-radius: 0px; gridline-color: #dcdcdc;
  selection-background-color: #d2d2d2; selection-color: #000000;
}
QListView::item, QTreeView::item { padding: 5px 6px; border: none; }
QTableView::item { padding: 0 8px; border: none; }
QListView::item:hover, QTreeView::item:hover, QTableView::item:hover { background: #e7e7e7; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #d2d2d2; color: #000000; }
QHeaderView { background: transparent; border: none; }
QHeaderView::section {
  background: #ffffff; color: #5c5c5c; border: none; border-bottom: 1px solid #bcbcbc; padding: 7px 8px;
  font-family: "Space Grotesk"; font-size: 11px; font-weight: 500;
}
QTableCornerButton::section { background: #ffffff; border: none; }
QTreeView::branch { background: transparent; }

/* ---------- group box ---------- */
QGroupBox { border: 1px solid #bcbcbc; border-radius: 0px; margin-top: 18px; padding: 14px 10px 10px; background: transparent; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0 6px; color: #5c5c5c;
  font-family: "Space Grotesk"; font-size: 11px; font-weight: 500; }

/* ---------- menus ---------- */
QMenuBar { background: #f2f2f2; color: #333333; border-bottom: 1px solid #dcdcdc; }
QMenuBar::item { background: transparent; padding: 6px 10px; border-radius: 0px; }
QMenuBar::item:selected { background: #e7e7e7; color: #111111; }
QMenu { background: #e9e9e9; color: #111111; border: 1px solid #868686; border-radius: 0px; padding: 4px; }
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 0px; background: transparent; }
QMenu::item:selected { background: #d2d2d2; color: #000000; }
QMenu::item:disabled { color: #a3a3a3; }
QMenu::separator { height: 1px; background: #bcbcbc; margin: 4px 6px; }
QMenu::indicator { width: 14px; height: 14px; left: 4px; }
QMenu::indicator:checked { image: url(mono:check-fg.svg); }

/* ---------- tooltip, status bar, toolbar ---------- */
QToolTip { background: #e4e4e4; color: #111111; border: 1px solid #868686; border-radius: 0px; padding: 5px 8px;
  font-family: "Space Mono"; font-size: 12px; }
QStatusBar { background: #ffffff; color: #5c5c5c; border-top: 1px solid #dcdcdc; }
QStatusBar QLabel { color: #5c5c5c; font-family: "Space Mono"; font-size: 12px; }
QToolBar { background: #f2f2f2; border: none; border-bottom: 1px solid #dcdcdc; spacing: 6px; padding: 4px; }
QToolBar::separator { background: #bcbcbc; width: 1px; margin: 4px 6px; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #868686; min-height: 28px; border-radius: 0px; }
QScrollBar::handle:horizontal { background: #868686; min-width: 28px; border-radius: 0px; }
QScrollBar::handle:hover { background: #5c5c5c; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---------- splitter, dock, misc ---------- */
QSplitter::handle { background: #dcdcdc; }
QSplitter::handle:hover { background: #868686; }
QDockWidget { color: #5c5c5c; titlebar-close-icon: none; }
QDockWidget::title { background: #ffffff; padding: 6px; border-bottom: 1px solid #bcbcbc; }
QSizeGrip { width: 12px; height: 12px; }
