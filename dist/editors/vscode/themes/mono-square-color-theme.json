{
  "$schema": "vscode://schemas/color-theme",
  "name": "Mono Square",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#0a0a0a",
    "editor.foreground": "#d5d5d5",
    "editorCursor.foreground": "#ffffff",
    "editor.lineHighlightBackground": "#101010",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#313131",
    "editor.inactiveSelectionBackground": "#31313199",
    "editor.selectionHighlightBackground": "#333333cc",
    "editor.wordHighlightBackground": "#333333cc",
    "editor.wordHighlightStrongBackground": "#333333",
    "editor.findMatchBackground": "#e2e2e2",
    "editor.findMatchHighlightBackground": "#55555599",
    "editor.findMatchBorder": "#ffffff",
    "editorLineNumber.foreground": "#787878",
    "editorLineNumber.activeForeground": "#e2e2e2",
    "editorIndentGuide.background1": "#202020",
    "editorIndentGuide.activeBackground1": "#3a3a3a",
    "editorWhitespace.foreground": "#202020",
    "editorRuler.foreground": "#202020",
    "editorBracketMatch.background": "#333333",
    "editorBracketMatch.border": "#656565",
    "editorBracketHighlight.foreground1": "#d5d5d5",
    "editorBracketHighlight.foreground2": "#919191",
    "editorBracketHighlight.foreground3": "#787878",
    "editorError.foreground": "#ffffff",
    "editorWarning.foreground": "#c6c6c6",
    "editorInfo.foreground": "#919191",
    "editorHint.foreground": "#787878",
    "editorGutter.background": "#0a0a0a",
    "editorGutter.addedBackground": "#d5d5d5",
    "editorGutter.modifiedBackground": "#919191",
    "editorGutter.deletedBackground": "#777777",
    "editorWidget.background": "#101010",
    "editorWidget.border": "#656565",
    "editorSuggestWidget.background": "#101010",
    "editorSuggestWidget.border": "#3a3a3a",
    "editorSuggestWidget.selectedBackground": "#313131",
    "editorSuggestWidget.highlightForeground": "#ffffff",
    "editorHoverWidget.background": "#101010",
    "editorHoverWidget.border": "#656565",
    "editorGroup.border": "#3a3a3a",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorInlayHint.foreground": "#787878",
    "editorInlayHint.background": "#00000000",
    "diffEditor.insertedTextBackground": "#e2e2e21a",
    "diffEditor.removedTextBackground": "#00000080",
    "focusBorder": "#656565",
    "foreground": "#d5d5d5",
    "descriptionForeground": "#919191",
    "errorForeground": "#ffffff",
    "icon.foreground": "#919191",
    "widget.border": "#3a3a3a",
    "selection.background": "#313131",
    "textLink.foreground": "#ffffff",
    "textLink.activeForeground": "#ffffff",
    "textPreformat.foreground": "#c6c6c6",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#d5d5d5",
    "activityBar.inactiveForeground": "#787878",
    "activityBar.border": "#3a3a3a",
    "activityBar.activeBorder": "#ffffff",
    "activityBarBadge.background": "#e2e2e2",
    "activityBarBadge.foreground": "#0a0a0a",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#d5d5d5",
    "sideBar.border": "#3a3a3a",
    "sideBarTitle.foreground": "#919191",
    "sideBarSectionHeader.background": "#000000",
    "sideBarSectionHeader.foreground": "#919191",
    "sideBarSectionHeader.border": "#3a3a3a",
    "list.activeSelectionBackground": "#313131",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#101010",
    "list.hoverBackground": "#101010",
    "list.highlightForeground": "#ffffff",
    "list.focusOutline": "#656565",
    "tab.activeBackground": "#0a0a0a",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#787878",
    "tab.border": "#3a3a3a",
    "tab.activeBorderTop": "#ffffff",
    "tab.hoverBackground": "#101010",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#d5d5d5",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#787878",
    "titleBar.border": "#3a3a3a",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#919191",
    "statusBar.border": "#3a3a3a",
    "statusBar.debuggingBackground": "#e2e2e2",
    "statusBar.debuggingForeground": "#0a0a0a",
    "statusBar.noFolderBackground": "#000000",
    "statusBarItem.remoteBackground": "#e2e2e2",
    "statusBarItem.remoteForeground": "#0a0a0a",
    "panel.background": "#000000",
    "panel.border": "#3a3a3a",
    "panelTitle.activeForeground": "#ffffff",
    "panelTitle.activeBorder": "#ffffff",
    "panelTitle.inactiveForeground": "#787878",
    "input.background": "#000000",
    "input.foreground": "#d5d5d5",
    "input.border": "#3a3a3a",
    "input.placeholderForeground": "#787878",
    "inputOption.activeBorder": "#ffffff",
    "dropdown.background": "#101010",
    "dropdown.border": "#3a3a3a",
    "button.background": "#e2e2e2",
    "button.foreground": "#0a0a0a",
    "button.hoverBackground": "#c6c6c6",
    "button.secondaryBackground": "#101010",
    "button.secondaryForeground": "#d5d5d5",
    "badge.background": "#151515",
    "badge.foreground": "#ffffff",
    "scrollbarSlider.background": "#65656559",
    "scrollbarSlider.hoverBackground": "#6565658c",
    "scrollbarSlider.activeBackground": "#656565cc",
    "progressBar.background": "#ffffff",
    "breadcrumb.foreground": "#787878",
    "breadcrumb.focusForeground": "#d5d5d5",
    "menu.background": "#101010",
    "menu.foreground": "#d5d5d5",
    "menu.selectionBackground": "#313131",
    "menu.border": "#656565",
    "notifications.background": "#101010",
    "notifications.border": "#3a3a3a",
    "peekView.border": "#656565",
    "peekViewEditor.background": "#000000",
    "peekViewResult.background": "#101010",
    "peekViewTitle.background": "#101010",
    "gitDecoration.addedResourceForeground": "#d5d5d5",
    "gitDecoration.modifiedResourceForeground": "#999999",
    "gitDecoration.deletedResourceForeground": "#777777",
    "gitDecoration.untrackedResourceForeground": "#c6c6c6",
    "gitDecoration.ignoredResourceForeground": "#555555",
    "terminal.background": "#0a0a0a",
    "terminal.foreground": "#d5d5d5",
    "terminalCursor.foreground": "#ffffff",
    "terminal.selectionBackground": "#88888880",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#555555",
    "terminal.ansiGreen": "#6b6b6b",
    "terminal.ansiYellow": "#818181",
    "terminal.ansiBlue": "#979797",
    "terminal.ansiMagenta": "#adadad",
    "terminal.ansiCyan": "#c3c3c3",
    "terminal.ansiWhite": "#d9d9d9",
    "terminal.ansiBrightBlack": "#333333",
    "terminal.ansiBrightRed": "#666666",
    "terminal.ansiBrightGreen": "#7c7c7c",
    "terminal.ansiBrightYellow": "#929292",
    "terminal.ansiBrightBlue": "#a8a8a8",
    "terminal.ansiBrightMagenta": "#bebebe",
    "terminal.ansiBrightCyan": "#d4d4d4",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#777777",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#999999",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#919191",
        "fontStyle": ""
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": ""
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": ""
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#e2e2e2",
        "fontStyle": ""
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": ""
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d5d5d5",
        "fontStyle": ""
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": ""
      }
    },
    {
      "name": "builtin",
      "scope": [
        "support.function.builtin",
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#e2e2e2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "macro",
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "entity.name.function.macro"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#999999",
        "fontStyle": "italic"
      }
    },
    {
      "name": "heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e2e2e2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#e2e2e2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": ""
      }
    },
    {
      "name": "added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#d5d5d5",
        "fontStyle": ""
      }
    },
    {
      "name": "removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#777777",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#999999",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#c6c6c6"
    },
    "class": {
      "foreground": "#c6c6c6",
      "italic": true
    },
    "enum": {
      "foreground": "#c6c6c6",
      "italic": true
    },
    "interface": {
      "foreground": "#c6c6c6",
      "italic": true
    },
    "struct": {
      "foreground": "#c6c6c6",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#c6c6c6",
      "italic": true
    },
    "type": {
      "foreground": "#c6c6c6",
      "italic": true
    },
    "parameter": {
      "foreground": "#c6c6c6",
      "italic": true
    },
    "variable": {
      "foreground": "#d5d5d5"
    },
    "property": {
      "foreground": "#c6c6c6"
    },
    "enumMember": {
      "foreground": "#ffffff"
    },
    "function": {
      "foreground": "#e2e2e2"
    },
    "method": {
      "foreground": "#e2e2e2"
    },
    "macro": {
      "foreground": "#ffffff",
      "italic": true
    },
    "keyword": {
      "foreground": "#ffffff",
      "bold": true
    },
    "comment": {
      "foreground": "#777777",
      "italic": true
    },
    "string": {
      "foreground": "#b4b4b4"
    },
    "number": {
      "foreground": "#ffffff"
    },
    "regexp": {
      "foreground": "#c6c6c6"
    },
    "operator": {
      "foreground": "#999999"
    },
    "variable.readonly": {
      "foreground": "#ffffff"
    },
    "variable.defaultLibrary": {
      "foreground": "#e2e2e2",
      "italic": true
    },
    "function.defaultLibrary": {
      "foreground": "#e2e2e2",
      "italic": true
    }
  }
}
