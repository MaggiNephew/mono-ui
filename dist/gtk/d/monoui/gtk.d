button:active, button:checked { background-color: #111111; color: #f2f2f2; border-color: #111111; }
button:disabled { color: #a3a3a3; border-color: #bcbcbc; background-color: transparent; }
button.fill, button.suggested-action { background-color: #111111; color: #f2f2f2; border-color: #111111; }
button.fill:hover, button.suggested-action:hover { background-color: #3a3a3a; border-color: #3a3a3a; }
button.fill label, button.suggested-action label { color: #f2f2f2; }
button.line { border-color: #868686; }
button.line:hover { border-color: #111111; }
button.ghost, button.flat { border-color: transparent; color: #5c5c5c; }
button.ghost:hover, button.flat:hover { color: #111111; background-color: #e7e7e7; }
button.destructive-action { border-color: #111111; border-style: dashed; }
button label { color: inherit; }

/* ---------- inputs ---------- */
entry, spinbutton:not(.vertical), textview text {
  background-image: none; background-color: #ffffff; color: #111111; box-shadow: none;
  border: 1px solid #bcbcbc; border-radius: 0px; min-height: 38px; padding: 0 10px;
  caret-color: #000000;
}
textview { background-color: #ffffff; }
textview text { padding: 6px 8px; }
entry:hover { border-color: #868686; }
entry:focus, spinbutton:focus { border: 1px solid #111111; }
entry placeholder, entry .dim-label { color: #858585; }
spinbutton entry { border: none; border-radius: 0; background: transparent; min-height: 0; }
spinbutton button { border: none; border-left: 1px solid #bcbcbc; border-radius: 0; min-height: 0; padding: 0 8px; }
combobox button.combo, dropdown button { background-color: #ffffff; border-color: #bcbcbc; color: #111111; }
combobox button.combo:hover { border-color: #868686; }
combobox arrow, menubutton arrow { -gtk-icon-source: none; background-image: url("@MONO_ICONS@/chevron-down.svg"); background-repeat: no-repeat; background-position: center; background-size: 10px 10px; min-width: 12px; min-height: 12px; }

/* ---------- check / radio / switch ---------- */
check, radio {
  background-image: none; background-color: #ffffff; border: 1px solid #868686; min-width: 14px; min-height: 14px;
  margin: 0 8px 0 0; color: #f2f2f2; -gtk-icon-source: none;
}
check { border-radius: 0px; }
radio { border-radius: 100%; }
check:hover, radio:hover { border-color: #111111; }
check:checked { background-color: #111111; border-color: #111111; -gtk-icon-source: url("@MONO_ICONS@/check.svg"); }
check:indeterminate { background-color: #111111; border-color: #111111; -gtk-icon-source: url("@MONO_ICONS@/dash.svg"); }
radio:checked { border-color: #111111; -gtk-icon-source: url("@MONO_ICONS@/radio.svg"); }
switch { background-color: #ffffff; border: 1px solid #868686; border-radius: 0px; min-width: 36px; min-height: 18px; color: transparent; font-size: 0; }
switch slider { background-image: none; box-shadow: none; background-color: #5c5c5c; border: none; border-radius: 0px; min-width: 14px; min-height: 14px; margin: 1px; }
switch:checked { background-color: #111111; border-color: #111111; }
switch:checked slider { background-image: none; background-color: #f2f2f2; }

/* ---------- sliders & progress ---------- */
scale trough { background-color: #868686; min-height: 2px; min-width: 2px; border-radius: 1px; border: none; }
scale trough highlight { background-image: none; background-color: #111111; border: none; border-radius: 1px; }
scale slider { background-color: #000000; border: none; min-width: 14px; min-height: 14px; margin: -6px; border-radius: 0px; box-shadow: none; }
progressbar trough { background-color: #dcdcdc; min-height: 4px; border: none; border-radius: 0px; }
progressbar progress { background-color: #111111; min-height: 4px; border: none; border-radius: 0px; }
levelbar block.filled { background-color: #111111; }
levelbar block.empty { background-color: #dcdcdc; }

/* ---------- notebook (tabs) ---------- */
notebook { background-color: transparent; }
notebook > header { background-color: transparent; border: none; box-shadow: none; }
notebook > header.top { border-bottom: 1px solid #bcbcbc; }
notebook > header tab { background-color: transparent; border: 1px solid transparent; border-bottom: none; padding: 6px 14px;
  border-radius: 0px 0px 0 0; color: #5c5c5c; box-shadow: none; }
notebook > header tab label { font-family: "Space Grotesk"; font-weight: 500; font-size: 11px; color: inherit; }
notebook > header tab:hover { color: #111111; }
notebook > header tab:checked { color: #111111; border-color: #bcbcbc; background-color: #f2f2f2; margin-bottom: -1px; }
notebook > stack { background-color: #f2f2f2; }

/* ---------- lists & trees ---------- */
list, treeview.view, iconview { background-color: #ffffff; color: #111111; }
list { border: 1px solid #bcbcbc; border-radius: 0px; }
list row { padding: 6px 10px; border-radius: 0px; }
list row:hover { background-color: #e7e7e7; }
list row:selected { background-color: #d2d2d2; color: #000000; }
treeview.view header button { background-color: #ffffff; color: #5c5c5c; border: none; border-bottom: 1px solid #bcbcbc;
  border-radius: 0; min-height: 0; padding: 6px 8px; font-size: 11px; }
treeview.view:selected { background-color: #d2d2d2; color: #000000; }

/* ---------- menus, popovers, tooltips ---------- */
menubar { background-color: #f2f2f2; border-bottom: 1px solid #dcdcdc; }
menu, .menu, popover, popover.background { background-color: #e9e9e9; color: #111111; border: 1px solid #868686; border-radius: 0px; }
menuitem { padding: 6px 12px; }
menuitem:hover { background-color: #d2d2d2; color: #000000; }
tooltip, tooltip.background { background-color: #e4e4e4; color: #111111; border: 1px solid #868686; border-radius: 0px; }
tooltip label { font-family: "Space Mono"; font-size: 12px; color: #111111; }

/* ---------- headerbar / statusbar ---------- */
headerbar { background-image: none; background-color: #f2f2f2; border-bottom: 1px solid #dcdcdc; box-shadow: none; min-height: 40px; }
headerbar .title { font-family: "Space Grotesk"; font-weight: 500; color: #111111; }
headerbar .subtitle { color: #5c5c5c; }
statusbar { background-color: #ffffff; border-top: 1px solid #dcdcdc; color: #5c5c5c; }
statusbar label { font-family: "Space Mono"; font-size: 12px; color: #5c5c5c; }

/* ---------- scrollbars ---------- */
scrollbar { background-color: transparent; border: none; }
scrollbar slider { background-color: #868686; border: none; border-radius: 0px; min-width: 6px; min-height: 6px; }
scrollbar slider:hover { background-color: #5c5c5c; }
MONOCSS";

private immutable string[2][][] iconsAll = [icons_square, icons_round, icons_blend, icons_paper];
private immutable string[] cssAll = [css_square, css_round, css_blend, css_paper];
