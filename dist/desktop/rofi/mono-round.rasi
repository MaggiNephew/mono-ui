/* Mono round for rofi: rofi -theme mono-round.rasi  (generated by mono-ui from tokens/mono.json -- edit the tokens, not this file) */
* {
    bg: #131313;  bg-alt: #1f1f1f;  fg: #e2e2e2;  fg-dim: #999999;
    line: #333333;  strong: #919191;  accent: #ffffff;  on-accent: #1b1b1b;
    background-color: transparent;
    text-color: @fg;
    font: "3270 Nerd Font Mono 12";
}
window { width: 640px; background-color: @bg; border: 1px; border-color: @strong; border-radius: 12px; padding: 14px; }
mainbox { spacing: 10px; children: [ inputbar, listview ]; }
inputbar { background-color: @bg-alt; border: 1px; border-color: @line; border-radius: 8px; padding: 8px 10px; spacing: 8px;
    children: [ prompt, entry ]; }
prompt { text-color: @fg-dim; }
entry { placeholder: "Search"; placeholder-color: @fg-dim; cursor: text; }
listview { lines: 8; spacing: 2px; scrollbar: false; }
element { padding: 7px 10px; border-radius: 6px; spacing: 10px; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element-icon { size: 18px; }
element-text { text-color: inherit; highlight: bold; }
message { border: 1px; border-color: @line; border-radius: 8px; padding: 8px; }
