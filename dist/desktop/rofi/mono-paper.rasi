/* Mono paper for rofi: rofi -theme mono-paper.rasi  (generated by mono-ui from tokens/mono.json -- edit the tokens, not this file) */
* {
    bg: #f2f2f2;  bg-alt: #e9e9e9;  fg: #111111;  fg-dim: #5c5c5c;
    line: #bcbcbc;  strong: #868686;  accent: #111111;  on-accent: #f2f2f2;
    background-color: transparent;
    text-color: @fg;
    font: "Space Grotesk 12";
}
window { width: 640px; background-color: @bg; border: 1px; border-color: @strong; border-radius: 0px; padding: 14px; }
mainbox { spacing: 10px; children: [ inputbar, listview ]; }
inputbar { background-color: @bg-alt; border: 1px; border-color: @line; border-radius: 0px; padding: 8px 10px; spacing: 8px;
    children: [ prompt, entry ]; }
prompt { text-color: @fg-dim; }
entry { placeholder: "Search"; placeholder-color: @fg-dim; cursor: text; }
listview { lines: 8; spacing: 2px; scrollbar: false; }
element { padding: 7px 10px; border-radius: 0px; spacing: 10px; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element-icon { size: 18px; }
element-text { text-color: inherit; highlight: bold; }
message { border: 1px; border-color: @line; border-radius: 0px; padding: 8px; }
